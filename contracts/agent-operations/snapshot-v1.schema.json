{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-ops:v1:snapshot",
  "title": "Agent Operations Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "agent-ops/v1"
    },
    "generated_at": {
      "type": "number",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "demo": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "systems": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/system"
      }
    },
    "agents": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "channels": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/channel"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "systems": {
              "type": "integer",
              "minimum": 0

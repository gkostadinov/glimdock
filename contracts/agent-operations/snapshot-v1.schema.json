            "agents": {
              "type": "integer",
              "minimum": 0
            },
            "tasks": {
              "type": "integer",
              "minimum": 0
            },
            "events": {
              "type": "integer",
              "minimum": 0
            },
            "resources": {
              "type": "integer",
              "minimum": 0
            },
            "channels": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "systems",
            "agents",
            "tasks",
            "events",
            "resources",
            "channels"
          ]

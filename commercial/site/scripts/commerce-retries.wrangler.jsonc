{
  "name": "glimdock-commerce-retries",
  "main": "commerce-retries-worker.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

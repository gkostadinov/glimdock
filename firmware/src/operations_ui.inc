int chosenSystem(){return operations?ops::systemIndex(*operations,selectedSystem):-1;}
bool includedSystem(uint8_t index){int selected=chosenSystem();return selected<0||selected==index;}
double operationAge(double sampled){
  if(!operations||!operations->valid||!isfinite(sampled))return NAN;
  double elapsed=uint32_t(millis()-operations->received)/1000.0;
  double now=double(time(nullptr));if(now<1700000000)now=operations->generated+elapsed;
  // A future clock is unknown, never freshly sampled.
  if(sampled>now+30)return NAN;return max(0.0,now-sampled);
}
bool sourceFresh(uint8_t index){if(!operations||!operations->valid||!operationsNet.connected||index>=operations->nSources)return false;auto&s=operations->sources[index];double age=operationAge(s.sampled);return isfinite(age)&&isfinite(s.ttl)&&age<=s.ttl&&(!strcmp(s.status,"healthy")||!strcmp(s.status,"degraded"));}
bool systemFresh(uint8_t index){if(!operations||index>=operations->nSystems)return false;auto&s=operations->systems[index];double age=operationAge(s.sampled);return sourceFresh(s.source)&&isfinite(age)&&age<=s.ttl;}
bool agentFresh(const ops::Agent&a){double age=operationAge(a.heartbeat);return sourceFresh(a.source)&&isfinite(age)&&age<=a.ttl;}
String operationAgeText(double sampled){double age=operationAge(sampled);return isfinite(age)?number(age,0,"s ago"):String("Age unknown");}
uint32_t stateColor(const char*state){return !strcmp(state,"failed")||!strcmp(state,"error")?RED:!strcmp(state,"blocked")||!strcmp(state,"waiting")||!strcmp(state,"degraded")?AMBER:!strcmp(state,"running")||!strcmp(state,"healthy")||!strcmp(state,"ready")||!strcmp(state,"ok")?MINT:MUTED;}
String agentState(const ops::Agent&a){return !operationsNet.connected?String("Offline"):agentFresh(a)?String(a.state):String("Stale");}

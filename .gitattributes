# Generated asset manifests bind exact bytes. Preserve LF on every platform,
# including Windows runners with core.autocrlf enabled.
* text=auto eol=lf

# Fonts, firmware, WebAssembly, archives and raster assets retain their bytes.
*.woff2 -text
*.wasm -text
*.bin -text
*.gz -text
*.zip -text
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
*.ico -text
*.pdf -text
*.stl -text
*.3mf -text

# Analytic CAD exports retain exporter bytes and are reviewed as CAD, not prose.
enclosure/public/portable-r45/cad/*.step -text -diff
enclosure/public/portable-r45/cad/*.brep -text -diff
# Keep the licensed upstream viewer library unchanged, including its formatting.
enclosure/public/portable-r45/viewer/vendor/** -whitespace

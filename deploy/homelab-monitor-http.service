[Unit]
Description=Homelab display authenticated snapshot reader
After=homelab-monitor-collector.service homelab-monitor-config.service network-online.target
Wants=homelab-monitor-collector.service homelab-monitor-config.service network-online.target

[Service]
Type=simple
User=homelab-monitor
Group=homelab-monitor
WorkingDirectory=/opt/homelab-monitor
EnvironmentFile=/etc/homelab-monitor/server.env
ExecStart=/usr/bin/python3 -B -m agent.server --bind ${HOMELAB_BIND} --port ${HOMELAB_PORT}
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=64M
TasksMax=20

[Install]
WantedBy=multi-user.target

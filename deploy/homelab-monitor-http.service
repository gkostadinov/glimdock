[Unit]
Description=Glimdock authenticated snapshot reader (Rust)
After=homelab-monitor-collector.service homelab-monitor-config.service network-online.target
Wants=homelab-monitor-collector.service homelab-monitor-config.service network-online.target

[Service]
Type=simple
User=homelab-monitor
Group=homelab-monitor
WorkingDirectory=/opt/homelab-monitor
EnvironmentFile=/etc/homelab-monitor/server.env
ExecStart=/opt/homelab-monitor/glimdock-collector serve --snapshot /run/homelab-monitor/snapshot.json --bind ${HOMELAB_BIND} --port ${HOMELAB_PORT} --config-socket /run/homelab-monitor/config.sock
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=64M
TasksMax=20

[Install]
WantedBy=multi-user.target

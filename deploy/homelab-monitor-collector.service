[Unit]
Description=Homelab read-only privileged telemetry collector
After=pve-cluster.service network-online.target homelab-monitor-config.service
Wants=network-online.target homelab-monitor-config.service

[Service]
Type=simple
User=root
# pmxcfs/libqb rejects pvesh IPC when root's primary group is non-root.
Group=root
SupplementaryGroups=homelab-monitor
WorkingDirectory=/opt/homelab-monitor
ExecStart=/usr/bin/python3 -B -m agent.collector --config /etc/homelab-monitor/config.json --snapshot-group homelab-monitor
# The config service owns the shared root:homelab-monitor runtime directory.
# Declaring it here would make systemd reset config.sock to primary gid0.
UMask=0027
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/homelab-monitor
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target

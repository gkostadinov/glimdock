<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.glimdock.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/glimdock-agent</string>
    <string>--collector-url</string><string>https://collector.example.com</string>
    <string>--state-dir</string><string>/ABSOLUTE/PRIVATE/glimdock-agent</string>
    <string>--enrollment-key-file</string><string>/ABSOLUTE/PRIVATE/enrollment.key</string>
    <string>--config</string><string>/ABSOLUTE/PRIVATE/host.json</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/ABSOLUTE/LOGS/glimdock-agent.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/LOGS/glimdock-agent.error.log</string>
</dict>
</plist>

[Unit]
Description=Glimdock bounded node configuration service (Rust)
Before=homelab-monitor-collector.service homelab-monitor-http.service

[Service]
Type=simple
User=root
Group=homelab-monitor
WorkingDirectory=/opt/homelab-monitor
ExecStart=/opt/homelab-monitor/glimdock-collector config-service --config /etc/homelab-monitor/config.json --socket /run/homelab-monitor/config.sock --socket-group homelab-monitor
RuntimeDirectory=homelab-monitor
RuntimeDirectoryMode=02750
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/homelab-monitor /run/homelab-monitor
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=64M
TasksMax=20

[Install]
WantedBy=multi-user.target
